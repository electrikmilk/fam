{
  "name": "fam-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Plain-CSS skeuomorphic UI kit in the style of Mac OS X Aqua and iOS before version 7",
  "type": "module",
  "style": "dist/fam-ui.css",
  "files": [
    "css",
    "dist",
    "assets",
    "snippets",
    "README.md",
    "CREDITS.md"
  ],
  "exports": {
    ".": {
      "style": "./dist/fam-ui.css",
      "default": "./dist/fam-ui.css"
    },
    "./dist/*": "./dist/*",
    "./css/*": "./css/*",
    "./assets/*": "./assets/*",
    "./snippets/*": "./snippets/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node tools/bundle.mjs",
    "test": "npm run build && node --test tests/",
    "audit": "npm run build && node tools/contrast-audit.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "playwright-core": "^1.58.2",
    "pngjs": "^7.0.0"
  }
}
